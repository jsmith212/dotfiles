-- Hyprland monitor layout, rendered by hyprdynamicmonitors into ~/.config/hypr/monitors.lua.
-- This is a Go template that must produce Lua (hl.monitor calls), see
-- https://wiki.hypr.land/configuring/core/monitors/
-- Keep the TUI markers: upstream is moving its TUI/freeze output to Lua with these.

{{- $laptop := index .MonitorsByTag "laptop" -}}
{{- $external := index .MonitorsByTag "external" }}

{{ if isLidClosed -}}
hl.monitor({ output = "{{$laptop.Name}}", disabled = true })
{{- else -}}
hl.monitor({ output = "{{$laptop.Name}}", mode = "1920x1080@60.03300", position = "2680x1440", scale = 1, transform = 0, vrr = 0 })
{{- end }}
hl.monitor({ output = "{{$external.Name}}", mode = "3440x1440@99.98000", position = "1920x0", scale = 1, transform = 0, vrr = 0 })
